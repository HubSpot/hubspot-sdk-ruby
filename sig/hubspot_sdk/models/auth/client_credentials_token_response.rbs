          expires_in: Integer,
          token_type: String,
          token_use: HubSpotSDK::Models::Auth::ClientCredentialsTokenResponse::token_use,
          hub_id: Integer,
          id_token: String,
          scopes: ::Array[String],
          user_id: Integer
        }

        type token_use = :client_credentials

        module TokenUse
          extend HubSpotSDK::Internal::Type::Enum

